# C.R.D.O. — Variables de entorno (EJEMPLO v2, sin valores reales).
# Copiar a /opt/crdo/secrets/prod.env (y otro distinto a staging.env), chmod 600, dueño root.
# NUNCA subir el archivo con valores al repositorio (.gitignore lo bloquea).
# Generar cada contraseña/llave con:  openssl rand -base64 32

# --- Despliegue ---
CRDO_ENV=prod                          # prod | staging
CRDO_VERSION=0.1.0
CRDO_GHCR_OWNER=cambiar                # dueño del paquete en GitHub Container Registry
CRDO_SECRETS_FILE=/opt/crdo/secrets/prod.env
CRDO_DATA_DIR=/opt/crdo/data/prod
CRDO_API_PORT=8000                     # staging: 8100. Solo escucha en 127.0.0.1
PGVECTOR_TAG=cambiar                   # fijar versión exacta, p. ej. 0.8.x-pg16 (verificar la vigente)

# --- Base de datos (una contraseña distinta por rol y por entorno) ---
POSTGRES_OWNER_PASSWORD=
CRDO_DB_APP_PASSWORD=
CRDO_DB_READONLY_PASSWORD=
CRDO_DB_BACKUP_PASSWORD=
CRDO_DB_OPS_PASSWORD=
DATABASE_URL=postgresql://crdo_app:${CRDO_DB_APP_PASSWORD}@postgres:5432/crdo

# --- Seguridad de la app ---
CRDO_SECRET_KEY=                       # firma de sesiones
CRDO_ALLOWED_HOSTS=crdo-prod.<tu-tailnet>.ts.net

# --- Almacenamiento de objetos S3 (DIFERIDO: vacío hasta que haya archivos que guardar) ---
S3_ENDPOINT=
S3_BUCKET=crdo-prod-objects
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Monitoreo ---
HC_PING_HEARTBEAT=                     # URL de healthchecks.io

# --- Etapa 2: vacías a propósito; con la llave vacía los gateways responden "deshabilitado" ---
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=                 # proveedor alternativo (independencia de Claude)
OPENAI_COMPAT_BASE_URL=
CRDO_LLM_MONTHLY_LIMIT_USD=0

# --- Opcional (optional/edge): solo si se activa acceso público con Cloudflare ---
# TUNNEL_TOKEN=
# CRDO_CF_ACCESS_AUD=
