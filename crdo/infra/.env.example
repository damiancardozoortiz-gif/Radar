# C.R.D.O. — Variables de entorno (EJEMPLO v3, sin valores reales).
# Copiar a /opt/crdo/secrets/prod.env (y otro DISTINTO a staging.env), chmod 600, dueño root.
# Nunca subir el archivo con valores al repositorio (.gitignore lo bloquea).
# Contraseñas y llaves: openssl rand -base64 32

# --- Despliegue ---
CRDO_ENV=prod                          # prod | staging
CRDO_VERSION=0.1.0
CRDO_GHCR_OWNER=cambiar
CRDO_SECRETS_FILE=/opt/crdo/secrets/prod.env
CRDO_DATA_DIR=/opt/crdo/data/prod
CRDO_API_PORT=8000                     # staging: 8100. Solo 127.0.0.1
PGVECTOR_TAG=cambiar                   # fijar versión exacta (p. ej. 0.8.x-pg16; verificar la vigente)
CLOUDFLARED_VERSION=cambiar            # fijar versión exacta (solo perfil edge)
CRDO_TUNNEL_ENV_FILE=/opt/crdo/secrets/tunnel-prod.env   # staging: tunnel-staging.env

# --- Base de datos (una contraseña distinta por rol y por entorno) ---
POSTGRES_OWNER_PASSWORD=
CRDO_DB_APP_PASSWORD=
CRDO_DB_READONLY_PASSWORD=
CRDO_DB_BACKUP_PASSWORD=
CRDO_DB_OPS_PASSWORD=
DATABASE_URL=postgresql://crdo_app:${CRDO_DB_APP_PASSWORD}@postgres:5432/crdo

# --- App ---
CRDO_SECRET_KEY=
CRDO_ALLOWED_HOSTS=crdo-prod.<tailnet>.ts.net    # + panel.<dominio> cuando exista
CRDO_CF_ACCESS_TEAM=                   # perfil edge: equipo de Cloudflare Zero Trust
CRDO_CF_ACCESS_AUD=                    # perfil edge: audiencia de la aplicación de Access

# --- Almacenamiento de objetos R2 (OPCIONAL: vacío hasta activarlo en finance.cost_items) ---
S3_ENDPOINT=
S3_BUCKET=crdo-prod-objects
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- IA: presupuesto INDEPENDIENTE de la infraestructura (finance.budget_policy 'ai'). Vacío en Etapa 1 ---
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=

# Los avisos de healthchecks (backup, restore-test, budget, heartbeat) van en /opt/crdo/secrets/monitor.env
# y restic.env, no aquí.
