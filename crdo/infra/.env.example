# C.R.D.O. — Variables de entorno (EJEMPLO, sin valores reales).
# Copiar a /opt/crdo/secrets/prod.env (o staging.env), chmod 600, dueño root.
# NUNCA subir el archivo con valores al repositorio.

# --- Despliegue ---
CRDO_ENV=prod                          # prod | staging
CRDO_DOMAIN=ejemplo.com
CRDO_VERSION=0.1.0
CRDO_GHCR_OWNER=cambiar
CRDO_SECRETS_FILE=/opt/crdo/secrets/prod.env
CRDO_DATA_DIR=/opt/crdo/data/prod
CLOUDFLARED_VERSION=cambiar            # fijar versión exacta
CADDY_VERSION=cambiar                  # p. ej. 2.x.y-alpine
PGVECTOR_TAG=cambiar                   # p. ej. 0.x.y-pg16

# --- Base de datos ---
POSTGRES_OWNER_PASSWORD=               # openssl rand -base64 32
CRDO_DB_APP_PASSWORD=
CRDO_DB_READONLY_PASSWORD=
CRDO_DB_BACKUP_PASSWORD=
DATABASE_URL=postgresql://crdo_app:${CRDO_DB_APP_PASSWORD}@postgres:5432/crdo

# --- Seguridad de la app ---
CRDO_SECRET_KEY=                       # openssl rand -base64 48 (firma de sesiones)
CRDO_ENCRYPTION_KEY=                   # cifra secretos TOTP en BD
CRDO_ALLOWED_HOSTS=panel.ejemplo.com
CRDO_CF_ACCESS_AUD=                    # audiencia de Cloudflare Access (verificación del JWT)
CRDO_CF_ACCESS_TEAM=                   # equipo de Cloudflare Zero Trust

# --- Almacenamiento de objetos (S3 / R2) ---
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=crdo-prod-objects
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Monitoreo ---
HC_PING_HEARTBEAT=                     # URL de healthchecks.io
HC_PING_BACKUP=

# --- Etapa 2 (vacías a propósito: los gateways quedan deshabilitados) ---
ANTHROPIC_API_KEY=
CRDO_LLM_MONTHLY_LIMIT_USD=0
