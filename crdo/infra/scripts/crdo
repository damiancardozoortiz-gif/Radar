#!/usr/bin/env bash
# C.R.D.O. — CLI de operación (BORRADOR v3, no ejecutado en servidor). También lo invoca crdo-opsd.
#   crdo deploy <versión> [--env prod|staging]   despliega una imagen versionada, con rollback si falla /health
#   crdo rollback [--env prod|staging]           vuelve a la versión anterior registrada
#   crdo status                                  estado de contenedores, disco, presupuesto
#   --edge                                       incluye Cloudflare Tunnel (solo cuando exista dominio)
set -euo pipefail

APP=/opt/crdo/app/infra
RELEASES=/opt/crdo/releases
CMD="${1:-status}"; shift || true
ENV_NAME=prod
VERSION=""
EDGE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --env) ENV_NAME="$2"; shift 2 ;;
    --edge) EDGE=1; shift ;;
    *) VERSION="$1"; shift ;;
  esac
done
[[ "$ENV_NAME" == prod || "$ENV_NAME" == staging ]] || { echo "Entorno inválido" >&2; exit 1; }

SECRETS_FILE="/opt/crdo/secrets/$ENV_NAME.env"
FILES=(-f "$APP/compose.yml")
[[ "$ENV_NAME" == staging ]] && FILES+=(-f "$APP/compose.staging.yml")
SERVICES=(api worker scheduler postgres)
PROFILE=()
if [[ $EDGE == 1 ]]; then PROFILE=(--profile edge); SERVICES+=(cloudflared); fi

compose() { CRDO_VERSION="$1" docker compose -p "crdo-$ENV_NAME" --env-file "$SECRETS_FILE" "${FILES[@]}" "${PROFILE[@]}" "${@:2}"; }

healthy() {
  for _ in $(seq 1 20); do
    docker exec "crdo-$ENV_NAME-api-1" python -c \
      "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/health')" >/dev/null 2>&1 && return 0
    sleep 3
  done
  return 1
}

current() { grep ' ok$' "$RELEASES/$ENV_NAME.log" 2>/dev/null | tail -n1 | awk '{print $2}'; }  # última versión SANA

deploy() {
  local v="$1" prev; prev="$(current || true)"
  echo "Desplegando $v en $ENV_NAME (anterior: ${prev:-ninguna})"
  # En producción, siempre un respaldo justo antes de desplegar (si ya existe la base)
  if [[ "$ENV_NAME" == prod ]] && docker exec "crdo-prod-postgres-1" true 2>/dev/null; then
    systemctl start --wait crdo-backup.service || { echo "Respaldo previo falló: despliegue cancelado" >&2; exit 1; }
  fi
  compose "$v" pull api
  compose "$v" run --rm api python -m crdo.db.migrate   # migraciones compatibles hacia atrás
  compose "$v" up -d "${SERVICES[@]}"
  if healthy; then
    echo "$(date -Is) $v ok" >>"$RELEASES/$ENV_NAME.log"
    echo "OK: $v en $ENV_NAME"
  else
    echo "FALLÓ /health. Volviendo a ${prev:-(sin versión previa)}" >&2
    [[ -n "$prev" ]] && compose "$prev" up -d "${SERVICES[@]}"
    echo "$(date -Is) $v failed" >>"$RELEASES/$ENV_NAME.log"
    exit 1
  fi
}

case "$CMD" in
  deploy)   [[ -n "$VERSION" ]] || { echo "Falta versión" >&2; exit 1; }; deploy "$VERSION" ;;
  rollback) prev="$(grep ' ok$' "$RELEASES/$ENV_NAME.log" | tail -n2 | head -n1 | awk '{print $2}')"
            [[ -n "$prev" ]] || { echo "No hay versión anterior" >&2; exit 1; }; deploy "$prev" ;;
  status)   docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
            tail -n3 "$RELEASES/prod.log" "$RELEASES/staging.log" 2>/dev/null || true
            /opt/crdo/app/infra/scripts/budget-guard 2>/dev/null | head -n1 || true
            df -h / | tail -n1
            free -h | sed -n 2p ;;
  *) echo "Comando desconocido: $CMD" >&2; exit 1 ;;
esac
