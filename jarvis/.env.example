# Copia este archivo como .env (cp .env.example .env) y rellénalo.
# .env está fuera de git y jarvis.sh le pone permisos 600.

# Clave de ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voz que usa JARVIS. Vacío = la primera voz de tu cuenta.
# Elige una en https://elevenlabs.io/app/voice-library y copia su Voice ID.
ELEVENLABS_VOICE_ID=

# Opcional
# JARVIS_PORT=8790
# JARVIS_DEMO=1        # 1 = demo (por defecto), 0 = tus carpetas reales
