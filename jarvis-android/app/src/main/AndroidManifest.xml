<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Para ver los videos de la galería cuando le pides que los edite. Opcional: también puedes adjuntarlos a mano. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Lo que JARVIS puede saber de tu día. Todo opcional y apagado hasta que lo enciendas en Ajustes. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Para avisarte de lo que hace por iniciativa -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Para poder listar y abrir las aplicaciones instaladas, y usar el dictado y la voz del teléfono -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:name=".JarvisApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/copia"
        android:fullBackupContent="@xml/copia_antigua"
        android:networkSecurityConfig="@xml/red"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema.Jarvis">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.AjustesActivity" android:exported="false" android:label="Ajustes" />
        <activity android:name=".ui.MenteActivity" android:exported="false" android:label="Mente" />

        <!-- El oído para las notificaciones. Solo el sistema puede conectarse. -->
        <service
            android:name=".android.ServicioNotificaciones"
            android:exported="true"
            android:label="@string/avisos_nombre"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- El despertador de las rutinas de reloj -->
        <receiver android:name=".android.Despertador" android:exported="false" />

        <!-- Las manos y los ojos de JARVIS. Solo el sistema puede conectarse a este servicio. -->
        <service
            android:name=".android.ServicioAccesibilidad"
            android:exported="true"
            android:label="@string/servicio_nombre"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/servicio_accesibilidad" />
        </service>
    </application>
</manifest>
